# Mock mode is the default. Leave ALLO_API_KEY empty and the desk
# serves seeded fixtures plus a simulated event stream.
#
# Live mode: create a key in Allo at Settings → API and paste it here.
# The server sends it as `Authorization: Api-Key …` and checks it with
# GET https://api.withallo.com/v2/api/me. The key never reaches the browser.
ALLO_API_KEY=

# Signing secret from POST /v2/api/webhooks (the whsec_ value).
# Live mode needs this to accept deliveries at /api/webhooks/allo.
# Mock mode uses a built-in secret when this is empty:
#   whsec_YWxsby1jYWxsLWRlc2stbW9jay1rZXk=
ALLO_WEBHOOK_SECRET=

# Optional. Live mode otherwise uses the first type NUMBER row
# from GET /v2/api/numbers. E.164, for example +14155550100.
ALLO_NUMBER=
